{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustPad",
  "version": "0.1.1",
  "identifier": "app.rustpad.editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RustPad",
        "width": 1180,
        "height": 800,
        "minWidth": 680,
        "minHeight": 440,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "RustPad",
    "copyright": "Copyright © 2026 RustPad",
    "shortDescription": "Offline text and source code editor",
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3"
    },
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "rs",
          "js",
          "ts",
          "tsx",
          "jsx",
          "json",
          "html",
          "css",
          "md",
          "py",
          "php",
          "sql",
          "toml",
          "yaml",
          "yml",
          "log",
          "csv"
        ],
        "name": "Text and source code",
        "role": "Editor"
      }
    ]
  }
}
